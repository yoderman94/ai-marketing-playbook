# Settings for scripts/blog-pipeline.sh and scripts/doctor.sh.
# Copy this file to .env and change what you need. Every line is optional:
# a missing value uses the default shown. A variable already set in your shell wins.
# .env is gitignored. Never commit it.
#
# API keys for Exa, Tavily and Firecrawl do NOT go here. They live in your
# Claude Code MCP configuration (see docs/TOOLS.md), because the pipeline only
# reaches those services through Claude Code.

# --- Models (any name or alias `claude --model` accepts) -----------------------
# BLOG_MODEL_STANDARD=sonnet      # Stages 1, 5, 6, 7
# BLOG_MODEL_WRITING=opus         # Stages 2, 3, 4, 8
# BLOG_MODEL_RESEARCH=sonnet      # Stage 0

# --- Permissions for the headless stages ---------------------------------------
# allowlist (default): file edits are accepted and only BLOG_ALLOWED_TOOLS may run.
# bypass: --dangerously-skip-permissions. Every tool runs unchecked. Use only on a
#         machine and account you'd let an unattended agent control.
# BLOG_PERMISSION_MODE=allowlist
# BLOG_ALLOWED_TOOLS=             # space-separated; empty = the built-in list in blog-pipeline.sh
# BLOG_CLAUDE_EXTRA_ARGS=         # extra flags for every claude call, e.g. --max-turns 200
#                                 # Don't pass --setting-sources without "user": it also drops
#                                 # your user-level MCP servers (Exa, Tavily), and Stage 0 goes thin.

# --- Research ------------------------------------------------------------------
# SEARXNG_URL=http://localhost:8888
# SEARXNG_COMPOSE_DIR=            # default services/searxng; empty = never start Docker
# FIRECRAWL_URL=                  # set only if you self-host Firecrawl, e.g. http://127.0.0.1:3002

# --- Timing --------------------------------------------------------------------
# BLOG_STAGE_TIMEOUT=3h           # per stage; needs timeout (Linux) or gtimeout (macOS coreutils)
# BLOG_SLEEP_SONNET_LIGHT=30      # seconds after Stage 5
# BLOG_SLEEP_SONNET=60            # seconds after the other standard stages
# BLOG_SLEEP_OPUS=120             # seconds after the writing stages
# BLOG_SLEEP_BETWEEN_JOBS=120
# BLOG_SLEEP_BEFORE_FIRST_JOB=60  # time to press Ctrl-C if the router misread inputs/

# --- Paths ---------------------------------------------------------------------
# BLOG_LOG_DIR=                   # default <project>/logs
